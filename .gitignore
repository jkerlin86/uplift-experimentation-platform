# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data: raw and processed data are never committed (see data/README.md).
# The Criteo data are CC BY-NC-SA 4.0 and are reproduced by
# scripts/download_data.py from Criteo's official channel.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated outputs (regenerated by scripts/run_all.sh)
# reports/results.json is the single exception: it is committed as the
# rendered source of truth for README.md and reports/executive_summary.md,
# matching the prior portfolio projects.
reports/cache/
*.log
figures/*.png

# OS / editor
.DS_Store
.idea/
.vscode/

# Local credentials (never commit)
.env
